{
  "schemaVersion": 1,
  "id": "mod_observer",
  "version": "${version}",
  "name": "Mod Observer",
  "description": "Monitors the mods you have installed and sends that information to the server upon joining.",
  "authors": [
    "Sn0wix_"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/mod-observer",
    "issues": "https://github.com/Sn0wix/Mod-Observer/issues",
    "sources": "https://github.com/Sn0wix/Mod-Observer"
  },
  "license": "MIT",
  "icon": "assets/mod_observer/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "net.sn0wix_.modobserver.ModObserver"
    ],
    "modmenu": [
      "net.sn0wix_.modobserver.compat.ModMenuCompat"
    ]
  },
  "mixins": [
    "mod_observer.mixins.json"
  ],
  "depends": {
    "fabricloader": "*",
    "minecraft": ">=1.21.9",
    "java": "*",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "link.mod_observer.curseforge": "https://curseforge.com/minecraft/mc-mods/mod-observer",
        "link.mod_observer.modrinth": "https://modrinth.com/mod/mod-observer",
        "modmenu.discord": "https://discord.gg/nNYHDryaj3"
      },
      "update_checker": true
    }
  }
}